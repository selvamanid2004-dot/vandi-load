# =============================================================================
# Vandi Load - Environment Configuration Template
# Copy this file to .env and configure values before starting in production.
# DO NOT commit the actual .env file or real secrets to version control.
# =============================================================================

# Server Environment & Base URL
PORT=3000
NODE_ENV=production
APP_URL=http://localhost:3000

# CORS Allowed Origins (Comma-separated for multiple origins, e.g. https://vandiload.com,https://admin.vandiload.com)
ALLOWED_ORIGINS=http://localhost:3000

# Security & Authentication
# MUST be set to a strong, unique, high-entropy secret string in production (e.g., 64 random characters)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_characters

# Email Notification System (SMTP)
# Configure with live SMTP credentials to enable automated email delivery
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_smtp_username@gmail.com
EMAIL_PASSWORD=your_smtp_app_password
EMAIL_FROM="Vandi Load Logistics" <notifications@vandiload.com>

# Administrator Notification Recipient
# Overridable via the Admin Portal Settings page in the database
ADMIN_EMAIL=admin@vandiload.com

# Driver Confirmation Timeout (in milliseconds)
# Default: 300000 ms (5 minutes)
CONFIRMATION_TIMEOUT_MS=300000

# Map & Geolocation Configuration
# Maps are powered by Leaflet.js + OpenStreetMap tile server.
# No proprietary API keys or external billing required.
# If using a custom tile provider (e.g. Mapbox/Google Tiles), specify optional URL template here:
# MAP_TILE_LAYER_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
